      ],
      "form_fields": [
        {"field": "applicant_name", "label_ml": "പേര്", "label_en": "Name"},
        {"field": "aadhaar", "label_ml": "ആധാർ നമ്പർ", "label_en": "Aadhaar"},
        {"field": "address", "label_ml": "വിലാസം", "label_en": "Address"},
        {"field": "annual_income", "label_ml": "വാർഷിക വരുമാനം", "label_en": "Annual income"},
        {"field": "purpose", "label_ml": "ആവശ്യം", "label_en": "Purpose"}
