    {
      "id": "ration_card",
      "name_ml": "റേഷൻ കാർഡ്",
      "name_en": "Ration Card (PDS)",
      "department": "Department of Civil Supplies",
      "portal": "https://supplies.kerala.gov.in",
      "aliases": ["ration", "rashi kard", "pds", "ഭക്ഷ്യസുരക്ഷ", "ration card"],
      "summary_ml": "അർഹരായ കുടുംബങ്ങൾക്ക് സബ്സിഡി നിരക്കിൽ ഭക്ഷ്യധാന്യങ്ങൾ ലഭിക്കാനുള്ള കാർഡ്. പുതിയ കാർഡ്, വിഭജനം, പേര് മാറ്റം എന്നിവയ്ക്ക് അപേക്ഷിക്കാം.",
      "summary_en": "Family card for subsidized food grains. You can apply for a new card, division, or name change.",
      "eligibility": [
        {
          "field": "age",
          "question_ml": "അപേക്ഷകന്റെ വയസ്സ് 18-ഓ അതിൽ കൂടുതലോ ആണോ?",
          "question_en": "Is the applicant 18 or older (adult household head)?",
          "type": "number",
          "rule": {"op": "gte", "args": ["age", 18]},
          "failure_note_ml": "റേഷൻ കാർഡ് അപേക്ഷിക്കാൻ അപേക്ഷകൻ (കുടുംബനാഥൻ) പ്രായപൂർത്തിയായ ആളായിരിക്കണം. കുടുംബനാഥനായ മുതിർന്ന ഒരാളുടെ വിവരങ്ങൾ നൽകുക. 18 വയസ്സിൽ താഴെയുള്ളവർ കുടുംബാംഗമായി ഉൾപ്പെടുന്നതാണ്.",
          "failure_note_en": "The applicant (household head) must be an adult (18+). Ask the adult family head to apply; minors can be listed as family members."
        },
        {
          "field": "family_size",
          "question_ml": "കുടുംബത്തിലെ അംഗങ്ങളുടെ എണ്ണം എത്രയാണ്?",
          "question_en": "How many members in your family?",
          "type": "number",
          "rule": {"op": "gte", "args": ["family_size", 1]}
        },
        {
          "field": "already_has_card",
          "question_ml": "നിങ്ങളുടെ കുടുംബത്തിന് നിലവിൽ റേഷൻ കാർഡ് ഉണ്ടോ?",
          "question_en": "Does your family already have a ration card?",
          "type": "bool",
          "rule": {"op": "eq", "args": ["already_has_card", false]}
        },
        {
          "field": "family_survey_state",
          "question_ml": "കുടുംബ സർവേ (ഭക്ഷ്യസുരക്ഷാ സർവേ) നടന്നിട്ടുണ്ടോ?",
          "question_en": "Has the family survey (food security survey) happened?",
          "type": "bool",
          "rule": {"op": "eq", "args": ["family_survey_state", true]}
        }
      ],
      "documents": ["കുടുംബനാഥന്റെ ആധാർ", "വിലാസ തെളിവ്", "വരുമാന സർട്ടിഫിക്കറ്റ്", "കുടുംബ മെമ്പർഷിപ്പ് സർട്ടിഫിക്കറ്റ്"],
      "documents_en": ["Aadhaar of family head", "Address proof", "Income certificate", "Family membership certificate"],
      "steps": [
        "അക്ഷയ കേന്ദ്രത്തിൽ നിന്ന് e-Services ID സൃഷ്ടിക്കുക",
        "സേവന പോർട്ടലിൽ വിവരങ്ങൾ ശരിയായി പൂരിപ്പിച്ച് അപേക്ഷിക്കുക",
        "സപ്ലൈ ഇൻസ്പെക്ടറുടെ വീട്ടുപരിശോധന",
        "അംഗീകാരത്തിന് ശേഷം കാർഡ് ലഭിക്കും"
      ],
      "form_fields": [
        {"field": "applicant_name", "label_ml": "അപേക്ഷകന്റെ പേര്", "label_en": "Applicant name"},
        {"field": "aadhaar", "label_ml": "ആധാർ നമ്പർ", "label_en": "Aadhaar number"},
        {"field": "address", "label_ml": "വിലാസം", "label_en": "Address"},
        {"field": "family_size", "label_ml": "കുടുംബാംഗങ്ങളുടെ എണ്ണം", "label_en": "Family size"},
        {"field": "district", "label_ml": "ജില്ല", "label_en": "District"},
        {"field": "income_slab", "label_ml": "വാർഷിക വരുമാനം", "label_en": "Annual income"}
      ],
      "center": "aksaya"
    },
    {
      "id": "birth_certificate",
      "name_ml": "ജനന സർട്ടിഫിക്കറ്റ്",
      "name_en": "Birth Certificate",
      "department": "Civil Registration (LSGD / e-District)",
      "portal": "https://edistrict.kerala.gov.in",
      "aliases": ["birth", "ജനനം", "birth cert", "ജനന സർട്ടി"],
      "summary_ml": "ജനനം രജിസ്റ്റർ ചെയ്യാനും സർട്ടിഫിക്കറ്റ് ലഭിക്കാനുള്ള സേവനം. ജനനം കഴിഞ്ഞ് 21 ദിവസത്തിനുള്ളിൽ രജിസ്റ്റർ ചെയ്താൽ സൗജന്യമാണ്.",
      "summary_en": "Register births and get certificates. Free if registered within 21 days of birth.",
      "eligibility": [
        {
          "field": "registered_within_21",
          "question_ml": "ജനനം നടന്ന് 21 ദിവസം കഴിഞ്ഞോ?",
          "question_en": "Has it been more than 21 days since the birth?",
          "type": "bool",
          "rule": {"op": "eq", "args": ["registered_within_21", false]},
          "failure_note_ml": "21 ദിവസത്തിന് ശേഷം രജിസ്റ്റർ ചെയ്താൽ കാലതാമസ ഫീസ് ഉണ്ടാകും",
          "failure_note_en": "Late registration attracts a fee"
        }
      ],
      "documents": ["ആശുപത്രി ജനന രജിസ്റ്റർ തെളിവ് / ഹോസ്പിറ്റൽ സർട്ടിഫിക്കറ്റ്", "മാതാപിതാക്കളുടെ ആധാർ", "വിലാസ തെളിവ്"],
      "documents_en": ["Hospital birth register proof", "Parents' Aadhaar", "Address proof"],
      "steps": [
        "ജനനം നടന്ന ആശുപത്രിയിൽ / സ്ഥലത്ത് രജിസ്ട്രാർ ഓഫീസിൽ രജിസ്റ്റർ ചെയ്യുക",
        "ഫീസ് അടച്ച ശേഷം സർട്ടിഫിക്കറ്റ് ഇ-ഡിസ്ട്രിക്ട് വഴി ഡൗൺലോഡ് ചെയ്യുക",
        "പിഴവുണ്ടെങ്കിൽ രജിസ്ട്രാർ ഓഫീസിൽ നിന്ന് തിരുത്തൽ"
      ],
      "form_fields": [
        {"field": "child_name", "label_ml": "കുട്ടിയുടെ പേര്", "label_en": "Child name"},
        {"field": "birth_date", "label_ml": "ജനന തീയതി", "label_en": "Date of birth"},
        {"field": "hospital", "label_ml": "ജനിച്ച ആശുപത്രി", "label_en": "Hospital"},
        {"field": "father_name", "label_ml": "പിതാവിന്റെ പേര്", "label_en": "Father's name"},
        {"field": "mother_name", "label_ml": "മാതാവിന്റെ പേര്", "label_en": "Mother's name"}
      ],
      "center": "online"
    },
